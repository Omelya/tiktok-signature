# TikTok Signature Server Configuration
# Copy this file to .env and fill in your values

# Server port (default: 8080)
PORT=8080

# Proxy Configuration (optional)
# Set PROXY_ENABLED=true to use a proxy
PROXY_ENABLED=false
PROXY_HOST=proxy.example.com:8080
PROXY_USER=your_username
PROXY_PASS=your_password

# Chrome executable path (optional, auto-detected by default)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Auto-refresh tuning (optional)
# Restart browser after this many signatures (default: 500)
#MAX_GENERATIONS_BEFORE_REFRESH=500
# Restart browser after this many ms of session age (default: 1800000 = 30 min)
#MAX_SESSION_AGE_MS=1800000
# Identity pool (optional)
# Browser identities kept warm; requests rotate through them (default: 3)
#IDENTITY_POOL_SIZE=3
# Ignore POST /report for identities younger than this many ms (default: 15000)
#REPORT_MIN_AGE_MS=15000
# Minimum gap between report-driven retirements, ms (default: 20000)
#REPORT_RETIRE_COOLDOWN_MS=20000

# Low-resource tuning (optional)
# For low or bursty traffic, IDENTITY_POOL_SIZE=1 is usually enough and
# cuts RAM roughly by the pool factor.
# Close Chromium after this many ms without work; next request relaunches it
# (~10-20 s cold start). 0 = keep it running forever (default: 600000 = 10 min)
#IDLE_SHUTDOWN_MS=600000
# Launch the browser at startup (true) or on the first request (false)
#WARM_ON_START=true
# Share TikTok's static JS/CSS between identities instead of re-downloading
# it through the proxy for every new identity. 0 = off (default: 64)
#STATIC_CACHE_MAX_MB=64
# Request types aborted while an identity loads (default: image,media,font)
# Adding "stylesheet" saves more traffic but is untested against TikTok.
#BLOCKED_RESOURCE_TYPES=image,media,font
# Extra Chromium flags that disable its background services (default: true)
#LEAN_CHROME_FLAGS=true
